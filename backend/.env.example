# Local development template. Copy to backend/.env and fill in real values.
# Read at startup by spring-dotenv. Production uses the repo-root .env via Compose.

# Server
SERVER_PORT=8080

# Database (local Postgres)
DB_URL=jdbc:postgresql://localhost:5432/mohassib_db
DB_USER=postgres
DB_PASSWORD=change-me

# JWT (generate: openssl rand -base64 64 | tr -d '\n')
JWT_SECRET=change-me-min-256-bits-base64
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=30

# CORS (Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# File storage
FILES_DIR=./storage

# Mail (Zoho)
MAIL_HOST=smtp.zoho.com
MAIL_PORT=465
MAIL_PROTOCOL=smtp
MAIL_USERNAME=mohassib@zohomail.com
MAIL_PASSWORD=change-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_SSL=true
MAIL_SMTP_STARTTLS=false

# Google OAuth
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_SCOPE=email,profile

# Payroll (cross-check with DGI before launch)
PAYROLL_CNSS_RATE=0.0448
PAYROLL_CNSS_CEILING=6000
PAYROLL_IR_BRACKETS=0:0,2500:0.10,8333:0.20,17500:0.30,30000:0.34
