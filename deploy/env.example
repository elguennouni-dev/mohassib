# Copy to /opt/mohassib/.env on the VPS, then chmod 600.
# Used by the systemd unit (EnvironmentFile=) and backup.sh.

DB_URL=jdbc:postgresql://localhost:5432/mohassib_db
DB_USER=mohassib_admin
DB_PASSWORD=change-me

# Generate with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=change-me-min-256-bits-base64
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=30

CORS_ALLOWED_ORIGINS=https://mohassib.elguennouni.site
SERVER_PORT=8080
FILES_DIR=/var/lib/mohassib/storage

MAIL_HOST=smtp.zoho.com
MAIL_PORT=465
MAIL_USERNAME=mohassib@zohomail.com
MAIL_PASSWORD=change-me
MAIL_SMTP_SSL=true
MAIL_SMTP_STARTTLS=false

GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

PAYROLL_CNSS_RATE=0.0448
PAYROLL_CNSS_CEILING=6000
PAYROLL_IR_BRACKETS=0:0,2500:0.10,8333:0.20,17500:0.30,30000:0.34
