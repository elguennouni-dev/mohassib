# Single shared .env consumed by docker-compose.prod.yml.
# Copy to .env on the VPS and chmod 600.

# Postgres
POSTGRES_DB=mohassib_db
POSTGRES_USER=mohassib_admin
POSTGRES_PASSWORD=change-me

# JWT (generate: openssl rand -base64 64 | tr -d '\n')
JWT_SECRET=change-me-min-256-bits-base64
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=30

# CORS / frontend origin
CORS_ALLOWED_ORIGINS=https://mohassib.elguennouni.site
VITE_API_BASE_URL=/api/v1

# Mail (Zoho example)
MAIL_HOST=smtp.zoho.com
MAIL_PORT=465
MAIL_USERNAME=mohassib@zohomail.com
MAIL_PASSWORD=change-me
MAIL_SMTP_SSL=true
MAIL_SMTP_STARTTLS=false

# Google OAuth
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# Payroll (cross-check with DGI before launch)
PAYROLL_CNSS_RATE=0.0448
PAYROLL_CNSS_CEILING=6000
PAYROLL_IR_BRACKETS=0:0,2500:0.10,8333:0.20,17500:0.30,30000:0.34

# JVM
JAVA_OPTS=-Xms256m -Xmx512m
